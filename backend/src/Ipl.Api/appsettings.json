{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "ipl-franchise-platform",
    "Audience": "ipl-franchise-web",
    "SigningKey": ""
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "AppBaseUrl": "http://localhost:4200"
  },
  "Database": {
    "InitializeOnStartup": true,
    "Migrate": true
  },
  "Cricsheet": {
    "BaseUrl": "https://cricsheet.org/downloads/",
    "Datasets": [ "ipl", "t20s_male" ],
    "AutoImportDays": 7,
    "LocalFolder": null
  },
  "Media": {
    "Folder": "App_Data/media"
  },
  "DemoData": {
    "Enabled": false,
    "HistoricSeasons": 5
  },
  "Redis": {
    "Connection": ""
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "From": "no-reply@franchise.local"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "ApiBurst": 300,
    "ApiPerSecond": 20
  },
  "ReverseProxy": { "Enabled": false },
  "Swagger": { "Enabled": false },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
